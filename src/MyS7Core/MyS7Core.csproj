<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net472</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>
        <Version>1.0.1</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Copyright>bzj</Copyright>
        <PackageLicenseFile Condition="Exists('$(MSBuildThisFileDirectory)..\..\License.txt')">License.txt</PackageLicenseFile>
        <Company></Company>
        <Authors>bzj</Authors>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>MyS7Core.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../License.txt" Pack="true" Visible="false" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)..\..\License.txt')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="S7netplus" Version="0.20.0" />

    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

</Project>
